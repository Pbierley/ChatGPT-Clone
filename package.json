{
  "name": "chatgpt-electron",
  "version": "0.1.0",
  "main": "main.js",
  "private": true,
  "type": "commonjs",
  "dependencies": {
    "@reduxjs/toolkit": "^1.9.5",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.0.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^6.21.0",
    "openai": "^3.2.1",
    "pdfjs-dist": "^3.11.174",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^4.8.0",
    "react-redux": "^8.0.5",
    "socket.io-client": "^4.6.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/coverage-v8": "^1.6.0",
    "concurrently": "^8.2.2",
    "electron": "^27.0.0",
    "electron-builder": "^24.0.0",
    "happy-dom": "^20.9.0",
    "jsdom": "^29.1.0",
    "vite": "^4.3.9",
    "vitest": "^1.6.0",
    "wait-on": "^7.2.0"
  },
  "scripts": {
    "dev": "concurrently \"node server.js\" \"wait-on http://localhost:3001/api/health && vite\"",
    "start": "node server.js",
    "build": "vite build",
    "preview": "vite preview",
    "electron-dev": "concurrently \"vite\" \"wait-on http://localhost:3000 && env -u ELECTRON_RUN_AS_NODE ELECTRON_IS_DEV=1 electron .\"",
    "electron-prod": "vite build && env -u ELECTRON_RUN_AS_NODE NODE_ENV=production electron .",
    "dist": "vite build && electron-builder",
    "clean": "rm -rf dist build node_modules/.vite",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "build": {
    "appId": "com.nku.chatgpt-electron",
    "productName": "ChatGPT Electron",
    "files": [
      "main.js",
      "preload.js",
      "build/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
